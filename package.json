{
  "name": "predator-runner",
  "version": "1.8.3",
  "description": "Docker image that runs predator load tests",
  "main": "index.js",
  "scripts": {
    "system-tests": "./tests/run.sh system-tests",
    "local-system-tests": "./tests/run.sh local-system-tests",
    "integration-tests": "./tests/run.sh integration-tests",
    "unit-tests": "ARRIVAL_RATE=1 DURATION=1 c8 --check-coverage --lines 30 --reporter=html --reporter=text mocha ./tests/unit-tests --recursive --exit",
    "lint": "node_modules/eslint/bin/eslint.js app/**",
    "release": "standard-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/predator-oss/predator-runner.git"
  },
  "keywords": [
    "runner",
    "performance",
    "artillery,",
    "predator"
  ],
  "author": "predator-oss",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/predator-oss/predator-runner/issues"
  },
  "homepage": "https://github.com/predator-oss/predator-runner#readme",
  "dependencies": {
    "artillery": "https://github.com/PayU/artillery.git",
    "artillery-plugin-expect": "https://github.com/enudler/artillery-plugin-expect.git",
    "artillery-plugin-influxdb": "https://github.com/enudler/artillery-plugin-influxdb.git",
    "artillery-plugin-prometheus": "^1.3.3",
    "bunyan": "^1.8.14",
    "csv-parse": "^4.8.8",
    "pidusage": "^2.0.20",
    "semver": "^7.3.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@hapi/hapi": "^18.4.1",
    "chai": "^4.1.2",
    "colors": "^1.3.3",
    "eslint": "^6.2.2",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-node": "^9.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "lodash": "^4.17.21",
    "mocha": "^8.1.1",
    "mochawesome": "^4.1.0",
    "nock": "^10.0.6",
    "proxyquire": "^2.1.3",
    "rewire": "^5.0.0",
    "should": "^13.2.3",
    "sinon": "4.1.3",
    "standard-version": "^9.3.1",
    "c8": "^10.1.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "got": "^11.8.6",
    "qs": "^6.14.1",
    "form-data": "^2.5.6",
    "tmp": "^0.2.6",
    "parseuri": "^3.0.2",
    "brace-expansion@1": "^1.1.12",
    "brace-expansion@2": "^2.0.2",
    "xmldom": "npm:@xmldom/xmldom@^0.9.8",
    "underscore": "^1.13.7",
    "tough-cookie@2": "^4.1.4",
    "rimraf@2": "^5.0.10"
  }
}